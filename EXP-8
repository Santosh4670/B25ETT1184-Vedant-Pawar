
#include <iostream>
#include <string>
using namespace std;

// Base class 1: Employee basic information
class Employee {
protected:
    int empId;
    string empName;
    int age;

public:
    void getEmployeeDetails() {
        cout << "Enter Employee ID: ";
        cin >> empId;

        cout << "Enter Employee Name: ";
        cin.ignore();
        getline(cin, empName);

        cout << "Enter Age: ";
        cin >> age;
    }
};

