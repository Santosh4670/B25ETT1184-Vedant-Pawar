    int n;

    cout << "Enter number of employees: ";
    cin >> n;

    EmployeeProfile emp[50];

    for (int i = 0; i < n; i++) {
        cout << "\nEnter details of Employee "
             << i + 1 << endl;
        emp[i].getDetails();
    }

    cout << "\n========== DEPARTMENT-WISE EMPLOYEE PROFILES ==========";

    for (int i = 0; i < n; i++) {
        emp[i].displayDetails();
    }

